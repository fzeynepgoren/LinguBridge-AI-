# LinguBridge AI — Backend ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Google Gemini API key (https://aistudio.google.com/apikey)
# Boş bırakırsanız sistem fallback (kural tabanlı + MyMemory) modunda çalışır.
GEMINI_API_KEY=your-gemini-api-key-here

# Kullanılacak Gemini modeli
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin'leri (virgülle ayrılmış)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MyMemory için opsiyonel email (günlük limiti artırır)
MYMEMORY_EMAIL=

# LLM çağrısı timeout (saniye) — gemini-2.5-flash thinking için 15-20 önerilir
LLM_TIMEOUT_SECONDS=20
